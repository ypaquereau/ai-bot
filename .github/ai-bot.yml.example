# Copy this file to .github/ai-bot.yml in any repository where you want to
# tune the bot's behaviour. All fields are optional; anything you omit falls
# back to the default in src/shared/config-schema.ts.

# Model to use (run `agent --list-models` to see what's available to your
# account). Omit to use the CLI's default.
# model: gpt-5

# Open pull requests as drafts (recommended) or ready-for-review.
draftPullRequest: true

# Prefix used for branches created by the implement step.
branchPrefix: ai-bot/

# Base branch for pull requests. Omit to use the repository's default branch.
# baseBranch: main

# Shell commands the agent is allowed to run during the implement step (plan
# is always read-only regardless of this list, via Cursor's --mode plan).
# Each entry becomes a `Shell(head:rest*)` rule in `.cursor/cli.json`
# (e.g. "npm test" -> Shell(npm:test*)). The implement step also passes
# --force, which Cursor documents as allowing anything not explicitly
# denied without prompting — so this list mainly documents intent; the
# actual safety boundary is the hardcoded secrets deny list in
# src/runner/cursor-permissions.ts.
allowedBashCommands:
  - "npm install"
  - "npm test"
  - "npm run build"
  - "npm run lint"

# Identity used for commits made by the bot.
gitIdentity:
  name: "ai-bot[bot]"
  email: "ai-bot[bot]@users.noreply.github.com"
