{
  "name": "ai-bot",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub App qui pilote un agent IA (Cursor CLI) a partir des labels d'une issue",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:server": "tsx watch src/server/index.ts",
    "start:server": "node dist/server/index.js",
    "start:runner": "node dist/runner/index.js",
    "local:cluster": "bash scripts/local-cluster.sh",
    "simulate:webhook": "node scripts/simulate-webhook.mjs"
  },
  "dependencies": {
    "@octokit/auth-app": "^7.1.3",
    "@octokit/rest": "^21.0.2",
    "@octokit/webhooks": "^13.3.0",
    "@octokit/webhooks-types": "^7.6.1",
    "@kubernetes/client-node": "^0.22.1",
    "hono": "^4.6.9",
    "@hono/node-server": "^1.13.7",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
